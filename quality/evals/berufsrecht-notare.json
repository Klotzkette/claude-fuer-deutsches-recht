      "deliverables": [
        "ergebnis.md"
      ],
      "criteria": [
        {
          "id": "C01",
          "text": "Das Ergebnis ordnet die frühere einseitige anwaltliche Vertragsverhandlung derselben Angelegenheit zu und prüft das notarielle Mitwirkungsverbot statt allein anwaltlicher Interessenkollision.",
          "deliverables": [
            "ergebnis.md"
          ]
        },
        {
          "id": "C02",
          "text": "Das spätere Einverständnis wird nicht mit einem damaligen Auftrag aller Beteiligten gleichgesetzt; die Beurkundung durch Huber wird nicht allein wegen der Zustimmung freigegeben.",
          "deliverables": [
            "ergebnis.md"
          ]
        },
        {
          "id": "C03",
          "text": "Die Nachricht erläutert sachlich die erforderliche anderweitige Beurkundung, ohne vertrauliche Verhandlungstaktik offenzulegen oder eine bereits unwirksame Urkunde zu behaupten.",
          "deliverables": [
            "ergebnis.md"
          ]
        }
      ],
      "target_skill": "nebentaetigkeit-und-interessenkollision-kaltstart-und-fa"
