{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Klotzkette/dieselgate/schema/dms-register/1.0.0",
  "title": "Dieselgate DMS-Registerzeile",
  "description": "Vertrag für eine Zeile des semikolongetrennten DMS-Registers.",
  "x-csv": {
    "encoding": "UTF-8",
    "delimiter": ";",
    "columns": [
      "schema_version",
      "dokument_id",
      "datei",
      "zielregister",
      "dokumenttyp",
      "datum",
      "absender",
      "empfaenger",
      "aktenzeichen",
      "fin",
      "motorcode",
      "betrag",
      "frist",
      "datenschutzklasse",
      "quelle",
      "sha256",
      "konfliktstatus",
      "bemerkung"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dokument_id",
    "datei",
    "zielregister",
    "dokumenttyp",
    "datum",
    "absender",
    "empfaenger",
    "aktenzeichen",
    "fin",
    "motorcode",
    "betrag",
    "frist",
    "datenschutzklasse",
    "quelle",
    "sha256",
    "konfliktstatus",
    "bemerkung"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dokument_id": {"type": "string", "minLength": 1},
    "datei": {"type": "string", "minLength": 1},
    "zielregister": {"type": "string", "minLength": 1},
    "dokumenttyp": {"type": "string", "minLength": 1},
    "datum": {"type": "string", "pattern": "^(|\\d{4}-\\d{2}-\\d{2})$"},
    "absender": {"type": "string"},
    "empfaenger": {"type": "string"},
    "aktenzeichen": {"type": "string"},
    "fin": {"type": "string"},
    "motorcode": {"type": "string"},
    "betrag": {"type": "string", "pattern": "^(|[0-9]+\\.[0-9]{2})$"},
    "frist": {"type": "string", "pattern": "^(|\\d{4}-\\d{2}-\\d{2})$"},
    "datenschutzklasse": {"enum": ["oeffentlich", "intern", "vertraulich", "besonders-sensibel"]},
    "quelle": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
    "konfliktstatus": {"enum": ["kein-konflikt", "ungeklaert", "widerspruch"]},
    "bemerkung": {"type": "string"}
  }
}
